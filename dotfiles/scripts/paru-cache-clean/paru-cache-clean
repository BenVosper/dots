#!/bin/bash
# Trim paru's AUR build cache: keep the newest 2 built versions of each
# installed package, drop built packages that are no longer installed, and
# remove downloaded source tarballs older than 30 days, and delete clone dirs
# for packages that are no longer installed.

clone_dir="$HOME/.cache/paru/clone"

shopt -s nullglob
dirs=()
for d in "$clone_dir"/*/; do
    dirs+=(-c "$d")
done
[ ${#dirs[@]} -eq 0 ] && exit 0

paccache -rk2 "${dirs[@]}"
paccache -ruk0 "${dirs[@]}"
find "$clone_dir" -mindepth 2 -maxdepth 2 -type f -name '*.tar.gz' -mtime +30 -delete

# Remove the whole clone dir when none of the packages it builds are installed.
# Dir names are the pkgbase, so check every pkgname listed in .SRCINFO.
for d in "$clone_dir"/*/; do
    d=${d%/}
    names=$(sed -n 's/^pkgname = //p' "$d/.SRCINFO" 2>/dev/null)
    [ -z "$names" ] && names=$(basename "$d")
    installed=
    for n in $names; do
        pacman -Qq "$n" &>/dev/null && installed=1 && break
    done
    if [ -z "$installed" ]; then
        echo "removing uninstalled: $(basename "$d")"
        rm -rf -- "$d"
    fi
done
